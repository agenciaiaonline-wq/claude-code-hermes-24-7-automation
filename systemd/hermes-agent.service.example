[Unit]
Description=Hermes Agent 24/7 Autonomous Gateway
After=network-online.target omniroute.service
Requires=omniroute.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
EnvironmentFile=/home/ubuntu/.hermes/.env
ExecStart=/home/ubuntu/.local/bin/hermes gateway run
Restart=always
RestartSec=10
MemoryMax=2G
CPUQuota=180%

[Install]
WantedBy=multi-user.target
