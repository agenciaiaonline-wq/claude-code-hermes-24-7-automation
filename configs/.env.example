# ==============================================================================
# SANITIZED EXAMPLE ENVIRONMENT FILE - NEVER COMMIT REAL SECRETS TO GIT
# Copy to .env and replace placeholders with your own generated credentials.
# ==============================================================================

# --- OmniRoute AI Gateway ---
OMNIROUTE_API_KEY=sk-example-replace-with-local-omniroute-key
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
NODE_OPTIONS=--max-old-space-size=2048

# OmniRoute OAuth & Quota Stability Tuning
HEALTHCHECK_BATCH_SIZE=1
HEALTHCHECK_STAGGER_MS=5000
HEALTHCHECK_JITTER_MIN_MS=1500
HEALTHCHECK_JITTER_MAX_MS=6000
PROVIDER_LIMITS_SYNC_INTERVAL_MINUTES=120
PROVIDER_LIMITS_SYNC_SPACING_MS=4000
OMNIROUTE_QUOTA_FETCH_MIN_INTERVAL_MS=1500
OMNIROUTE_QUOTA_FETCH_JITTER_MS=1000
CREDENTIAL_HEALTH_CHECK_INTERVAL=21600000

# --- Hermes Agent ---
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_API_KEY=sk-example-replace-with-local-omniroute-key
TELEGRAM_BOT_TOKEN=0000000000:EXAMPLE_REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_GROUP_ALLOWED_USERS=123456789

# --- Claude Code CLI ---
ANTHROPIC_BASE_URL=http://127.0.0.1:20128/v1
ANTHROPIC_AUTH_TOKEN=sk-example-replace-with-local-omniroute-key

# --- Playwright Extension / CDP ---
PLAYWRIGHT_MCP_EXTENSION_TOKEN=example-playwright-token-replace-me
CDP_ENDPOINT=http://127.0.0.1:9224

# --- Docker Core Stack ---
POSTGRES_USER=agency_admin
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=agency_core

REDIS_PASSWORD=change-me-strong-redis-password

N8N_ENCRYPTION_KEY=change-me-32-char-random-encryption-key
N8N_WEBHOOK_URL=https://n8n.your-domain.example.com/
GENERIC_TIMEZONE=UTC

WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-strong-waha-password
WAHA_API_KEY=change-me-strong-waha-api-key

# --- Task Bridge ---
BRIDGE_PORT=5050
HERMES_TMUX_SESSION=hermes-agent
